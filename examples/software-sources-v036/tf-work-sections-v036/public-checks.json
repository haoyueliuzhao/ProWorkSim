  "authority": "actor_visible_finite_examples_under_complete_public_contract",
  "cases": [
    {
      "case_id": "public-grouped-items",
      "group": "shared_api",
      "request": {
        "module": "adapter",
        "function": "work_items",
        "args": [
          "group oak\nitem cut 2\nitem paint 3\ngroup pine\nitem pack 1"
        ],
        "check_input_unchanged": true,
        "trace": [
          [
            "textfsm",
            "TextFSM.ParseText"
          ]
        ]
      },
      "expected": {
        "kind": "return",
        "value": [
          {
            "group": "oak",
            "item": "cut",
            "minutes": 2
          },
          {
            "group": "oak",
            "item": "paint",
            "minutes": 3
          },
          {
            "group": "pine",
            "item": "pack",
            "minutes": 1
          }
        ],
        "input_unchanged": true,
        "source_api_used": {
          "textfsm.TextFSM.ParseText": true
        },
        "source_api_observation_complete": true
      }
    },
