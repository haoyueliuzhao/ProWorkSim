    {
      "case_id": "public-prefix-times-reset-between-groups",
      "group": "consumer",
      "request": {
        "module": "consumer",
        "function": "work_timeline",
        "args": [
          "group oak\nitem cut 2\nitem paint 3\ngroup pine\nitem pack 1"
        ],
        "check_input_unchanged": true,
        "trace": [
          [
            "textfsm",
            "TextFSM.ParseText"
          ],
          [
            "adapter",
            "work_items"
          ]
        ]
      },
      "expected": {
        "kind": "return",
        "value": {
          "steps": [
            {
              "group": "oak",
              "item": "cut",
              "start": 0,
              "finish": 2
            },
            {
              "group": "oak",
              "item": "paint",
              "start": 2,
              "finish": 5
            },
            {
              "group": "pine",
              "item": "pack",
              "start": 0,
              "finish": 1
            }
          ],
          "totals": [
            {
              "group": "oak",
              "minutes": 5
            },
            {
              "group": "pine",
              "minutes": 1
            }
          ]
        },
        "input_unchanged": true,
        "source_api_used": {
          "textfsm.TextFSM.ParseText": true,
          "adapter.work_items": true
        },
        "source_api_observation_complete": true
      }
    },
