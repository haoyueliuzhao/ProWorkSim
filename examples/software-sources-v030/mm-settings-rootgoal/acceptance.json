{
  "authority": "independent model-interface screening only, never contribution or confirmation",
  "cases": [
    {
      "case_id": "independent-settings-secret-and-default",
      "group": "consumer",
      "request": {
        "module": "consumer",
        "function": "apply_settings",
        "args": [
          {
            "name": "alpha",
            "network": {
              "host": "example.org",
              "port": "443"
            },
            "token": "old",
            "irrelevant": 5
          },
          {
            "token": "new",
            "network": {
              "host": "backup.org"
            },
            "extra": "ignored"
          }
        ],
        "trace": [
          [
            "models",
            "SettingsSchema",
            "load"
          ],
          [
            "models",
            "SettingsSchema",
            "dump"
          ]
        ],
        "check_input_unchanged": true
      },
      "expected": {
        "kind": "return",
        "value": {
          "ok": true,
          "public": {
            "name": "alpha",
            "network": {
              "host": "backup.org",
              "port": 443
            },
            "retries": 3
          },
          "state": {
            "name": "alpha",
            "network": {
              "host": "backup.org",
              "port": 443
            },
            "token": "new",
            "retries": 3
          }
        },
        "source_api_used": {
          "models.SettingsSchema.load": true,
          "models.SettingsSchema.dump": true
        },
        "input_unchanged": true
      }
    },
