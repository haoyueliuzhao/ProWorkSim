{
  "authority": "public examples derived from the public requirements, not copied from hidden acceptance",
  "cases": [
    {
      "case_id": "public-envelope-many",
      "group": "consumer",
      "request": {
        "module": "consumer",
        "function": "unpack_envelope",
        "args": [
          {
            "items": [
              {
                "code": "pencil",
                "quantity": "2"
              },
              {
                "code": "paper",
                "quantity": 7
              }
            ]
          },
          true
        ]
      },
      "expected": {
        "kind": "return",
        "value": [
          {
            "code": "pencil",
            "quantity": 2
          },
          {
            "code": "paper",
            "quantity": 7
          }
        ]
      }
    },
    {
      "case_id": "public-envelope-single",
      "group": "consumer",
      "request": {
        "module": "consumer",
        "function": "unpack_envelope",
        "args": [
          {
            "item": {
              "code": "clip",
              "quantity": "9"
            }
          },
          false
        ]
      },
      "expected": {
        "kind": "return",
        "value": {
          "code": "clip",
          "quantity": 9
        }
      }
    },
    {
      "case_id": "public-envelope-empty",
      "group": "consumer",
      "request": {
        "module": "consumer",
        "function": "unpack_envelope",
        "args": [
          {
            "items": []
          },
          true
        ]
      },
      "expected": {
        "kind": "return",
        "value": []
      }
    }
  ]
}
