{
  "authority": "public examples derived from the public requirements, not copied from hidden acceptance",
  "cases": [
    {
      "case_id": "public-order-normal",
      "group": "consumer",
      "request": {
        "module": "consumer",
        "function": "import_orders",
        "args": [
          [
            {
              "orderId": "p-1",
              "buyer": {
                "email": "a@example.org"
              },
              "lines": [
                {
                  "sku": "pen",
                  "qty": "3"
                },
                {
                  "sku": "ink",
                  "qty": 2
                }
              ]
            }
          ]
        ]
      },
      "expected": {
        "kind": "return",
        "value": [
          {
            "id": "p-1",
            "email": "a@example.org",
            "units": 5,
            "skus": [
              "pen",
              "ink"
            ]
          }
        ]
      }
    },
    {
      "case_id": "public-orders-empty",
      "group": "consumer",
      "request": {
        "module": "consumer",
        "function": "import_orders",
        "args": [
          []
        ]
      },
      "expected": {
        "kind": "return",
        "value": []
      }
    }
  ]
}
