{
  "authority": "actor_visible_semantic_examples",
  "cases": [
    {
      "case_id": "public-names-schema-load",
      "group": "reusable_api",
      "request": {
        "module": "models",
        "function": "load",
        "args": [
          {
            "name": " Red  Elm "
          }
        ],
        "check_input_unchanged": true,
        "class": "NameSchema",
        "trace": [
          [
            "models",
            "NameSchema",
            "load"
          ]
        ]
      },
      "expected": {
        "kind": "return",
        "value": {
          "name": "red  elm"
        },
        "input_unchanged": true,
        "source_api_used": {
          "models.NameSchema.load": true
        },
        "source_api_observation_complete": true
      }
    },
    {
      "case_id": "public-names-schema-dump",
      "group": "reusable_api",
      "request": {
        "module": "models",
        "function": "dump",
        "args": [
          [
            {
              "name": "oak"
            },
            {
              "name": "blue pine"
            }
          ]
        ],
        "check_input_unchanged": true,
        "class": "NameSchema",
        "kwargs": {
          "many": true
        },
        "trace": [
          [
            "models",
            "NameSchema",
            "dump"
          ]
        ]
      },
      "expected": {
        "kind": "return",
        "value": [
          {
            "name": "oak"
          },
          {
            "name": "blue pine"
          }
        ],
        "input_unchanged": true,
        "source_api_used": {
          "models.NameSchema.dump": true
        },
        "source_api_observation_complete": true
      }
    },
    {
      "case_id": "public-names-search",
