e=[])\n assert not rejected['ok']\n after=w.store.load();assert after['work_items']==before['work_items']\nreport={'provenance_commit':'5e2de883fd128716cd402f0c12a18f0f68d8a59d','evidence_level':'Complete archived source, real WorldCore and ProjectSession, immutable JSON submissions and actual reviewer reads','classification':'Expected capability gap, not a regression or newly discovered v0.8 defect','missing_relation':'No public action records a located issue and scoped response/decision against an actual submission; approve and revise requirements cannot express it','calls':trace,'observations':{pid:w.session('reviewer',pid).observe() for pid in ['R','W']},'tool_names':{pid:[x['name'] for x in w.session('reviewer',pid).tools()] for pid in ['R','W']}}\nsource=hashlib.sha256()\nfor p in sorted(Path('/tmp/proworksim-v09-before-source/src').rglob('*.py')):source.update(str(p.relative_to('/tmp/proworksim-v09-before-source')).encode());source.update(p.read_bytes())\nreport['source_tree_sha256']=source.hexdigest()\nreport['driver_source']=Path(__file__).read_text()\natomic_write(root/'report.json',json_bytes(report));print(json.dumps({'path':str(root),'two_public_gaps_confirmed':True,'source_tree_sha256':source.hexdigest()}))\n"
