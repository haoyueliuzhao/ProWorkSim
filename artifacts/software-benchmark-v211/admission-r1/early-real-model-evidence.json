              "entry_metadata_sha256": "a21870e02a452465ced5b7366049b5c7faad9c255b11da9ed263518e05e910c5"
            },
            "action_id": "action-21",
            "logical_time": 21,
            "command_id": "command:member_001:staff-4bcb74c6bf4745c6a9c9d1a918091d19-21",
