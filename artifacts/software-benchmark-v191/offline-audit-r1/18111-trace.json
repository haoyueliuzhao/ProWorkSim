        "path": "lib/matplotlib/cbook/__init__.py",
        "old": "    elif isinstance(obj, np.flatiter):\n        # TODO do the finite filtering on this\n        return obj[0]\n    elif isinstance(obj, collections.abc.Iterator):\n        raise RuntimeError(\"matplotlib does not \"\n                           \"support generators as input\")\n    else:\n        return next(val for val in obj if safe_isfinite(val))",
        "new": "    elif isinstance(obj, np.flatiter):\n        # TODO do the finite filtering on this\n        return obj[0]\n    elif isinstance(obj, collections.abc.Iterator):\n        raise RuntimeError(\"matplotlib does not \"\n                           \"support generators as input\")\n    else:\n        for val in obj:\n            if safe_isfinite(val):\n                return val\n        # If none of the values were finite (e.g. the data is all NaN),\n        # fall back to the first element rather than raising StopIteration.\n        try:\n            return obj[0]\n        except (TypeError, IndexError, KeyError):\n            pass\n        raise StopIteration"
