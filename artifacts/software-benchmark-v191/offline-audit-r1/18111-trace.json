    {
      "request_id": "v181:matplotlib__matplotlib-24149:DEEPSEEK_NT_S1_M1_10_V181_B5000K:20261109180002:member_001:0010",
      "tool": "replace_file",
      "arguments": {
        "new": "    for bar_set in (bars, hbars):\n        # the first bar should have a nan in the location\n        nanful, *rest = bar_set\n        assert (~np.isfinite(nanful.xy)).any()\n        assert np.isfinite(nanful.get_width())\n        for b in rest:\n            assert np.isfinite(b.xy).all()\n            assert np.isfinite(b.get_width())\n\n\ndef test_bar_all_nan():\n    fig, ax = plt.subplots()\n    nan_bars = ax.bar([np.nan], [np.nan])[0]\n    assert np.isnan(nan_bars.get_x())\n    assert np.isnan(nan_bars.get_height())\n    assert np.isfinite(nan_bars.get_width())\n\n    nan_bars_h = ax.barh([np.nan], [np.nan])[0]\n    assert np.isnan(nan_bars_h.get_y())\n    assert np.isnan(nan_bars_h.get_width())\n    assert np.isfinite(nan_bars_h.get_height())",
