    {
      "request_id": "v181:astropy__astropy-14309:DEEPSEEK_NT_S1_M3_R_V181_B5000K:20261109180010:member_001:0010",
      "tool": "create_file",
      "arguments": {
        "path": "astropy/io/fits/tests/test_issue_identify_format_noargs.py",
        "text": "# Licensed under a 3-clause BSD style license - see LICENSE.rst\n\"\"\"Regression test for IndexError in is_fits when no positional args are given.\n\nMirrors the issue reproduction: identify_format(\"write\", Table, \"bububu.ecsv\",\nNone, [], {}) must not raise IndexError from astropy.io.fits.connect.is_fits.\n\"\"\"\n\nfrom astropy.io.fits.connect import is_fits\nfrom astropy.io.registry import identify_format\nfrom astropy.table import Table\n\n\ndef test_is_fits_no_args_no_fits_extension():\n    # Non-FITS path, no fileobj, no extra args -> must be False, not IndexError.\n    assert is_fits(\"write\", \"bububu.ecsv\", None) is False\n    assert is_fits(\"write\", \"bububu.ecsv\", None, *[]) is False\n\n\ndef test_is_fits_preserves_original_semantics():\n    # FITS extension still accepted.\n    assert is_fits(\"read\", \"a.fits\", None) is True\n    # Non-empty args still inspected as before.\n    assert is_fits(\"write\", \"bububu.ecsv\", None, Table()) is False\n\n\ndef test_identify_format_issue_reproduction():\n    fmts = identify_format(\"write\", Table, \"bububu.ecsv\", None, [], {})\n    assert \"fits\" not in fmts\n    assert isinstance(fmts, list)\n"
      },
