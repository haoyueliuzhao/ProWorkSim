  "findings": [
    {
      "id": "F1",
      "status": "observed",
      "statement": "REF uses the native five-tool interface and has no PROJECT member, fixed-patch, same-version-delivery or submit requirement. The complete runtime adds explicit v062 control messages and observation guidance; only the static system preset is byte-identical to the frozen native manifest."
    },
    {
      "id": "F2",
      "status": "observed",
      "statement": "Default system guidance and v062 initial workflow both emphasize exploration, independent verification and edge cases. Neither inspected workflow requires all repository tests to pass. Public frontend advice explicitly tells the model to select targets from the issue/public checkout."
    },
    {
      "id": "F3",
      "status": "observed",
      "statement": "The extra final self-review is bounded to one and explicitly allows already-sufficient evidence without rerunning tests. Slot329 had no finish review and one stuck correction; its cost is not explained by repeated harness-enforced final reviews."
    },
    {
      "id": "F4",
      "status": "observed",
      "statement": "Native multi-command format rejections occurred 10 times in slot329. The added feedback neither rewrites nor automatically retries commands. The original tool parser still accepts explicitly chained commands or scripts."
    },
    {
      "id": "F5",
      "status": "observed",
      "statement": "The same-model condenser shares the original ledger, starts from max_size80/keep_first4 and also respects the effective agent input token threshold when max_tokens is null. Token-pressure hard condensation is present in the frozen runtime source. Slot329 condenser token share was about 0.85 percent; wall-time share is not measured here."
    },
    {
      "id": "H1",
      "status": "unverified_hypothesis",
      "statement": "Repeated verification language or displaying a repository-wide default test frontend may encourage excess exploration or broad test selection; no ablation isolates this causal effect."
    },
    {
      "id": "H2",
      "status": "unverified_hypothesis",
      "statement": "Condenser summaries could affect repeated investigation or retention; token cost alone does not measure summary quality. No claim of a context-forgetting defect is established by this static audit."
    }
  ],
