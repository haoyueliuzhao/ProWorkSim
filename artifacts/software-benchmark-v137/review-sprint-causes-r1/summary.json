    "patch_text": "diff --git a/src/_pytest/python.py b/src/_pytest/python.py\nindex 306e5f217ce1cf187eb6262c587002c894acaa37..1458d47cf730753d284d2546b7cac9baabc5bc41 100644\n--- a/src/_pytest/python.py\n+++ b/src/_pytest/python.py\n@@ -181,6 +181,21 @@ def pytest_collect_file(path, parent):\n                 path, parent.config.getini(\"python_files\") + [\"__init__.py\"]\n             ):\n                 return\n+            # ``__init__.py`` files are collected implicitly only when they\n+            # belong to the package hierarchy of a collected path: either the\n+            # parent already is the corresponding ``Package``, the user listed\n+            # ``__init__.py`` explicitly in ``python_files``, or it is the\n+            # ``__init__.py`` of the directory containing a path given on the\n+            # command line. Otherwise arbitrary ``__init__.py`` files would be\n+            # imported and could fail the whole test run (#6047).\n+            if path.basename == \"__init__.py\" and not isinstance(parent, Package):\n+                if not path_matches_patterns(\n+                    path, parent.config.getini(\"python_files\")\n+                ) and not any(\n+                    initpath.dirpath() == path.dirpath()\n+                    for initpath in parent.session._initialpaths\n+                ):\n+                    return\n         ihook = parent.session.gethookproxy(path)\n         return ihook.pytest_pycollect_makemodule(path=path, parent=parent)\n \ndiff --git a/testing/test_collection_regression_6047.py b/testing/test_collection_regression_6047.py\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..65e4cdea893fd6d2c59b37c93600b21229ca0180\n--- /dev/null\n+++ b/testing/test_collection_regression_6047.py\n@@ -0,0 +1,33 @@\n+\"\"\"Regression test for #6047.\n+\n+pytest must not collect and import arbitrary ``__init__.py`` files which do\n+not match ``python_files``; doing so can break the whole test run when such a\n+package is not importable on the current platform.\n+\"\"\"\n+\n+\n+def test_stray_init_not_collected(testdir):\n+    testdir.mkpydir(\"foobar\")\n+    testdir.makepyfile(\n+        foobar=\"assert False  # would fail at import time if collected\"\n+    )\n+    testdir.makepyfile(test_foo=\"def test_ok():\\n    assert True\\n\")\n+    result = testdir.runpytest(\"--collect-only\")\n+    result.stdout.fnmatch_lines([\"*collected 1 item*\", \"*<Module test_foo.py>*\"])\n+    assert \"__init__.py\" not in result.stdout.str()\n+    # Running for real must not error out on the stray package.\n+    result = testdir.runpytest()\n+    result.stdout.fnmatch_lines([\"*1 passed*\"])\n+\n+\n+def test_init_collected_when_matching(testdir):\n+    testdir.makepyfile(\n+        test_foo=\"def test_foo():\\n    assert True\\n\",\n+    )\n+    testdir.mkpydir(\"pkg\")\n+    testdir.makepyfile(**{\"pkg/__init__\": \"def test_init():\\n    assert True\\n\"})\n+    testdir.tmpdir.join(\"tox.ini\").write(\"[pytest]\\npython_files = *.py\\n\")\n+    result = testdir.runpytest(\"--collect-only\")\n+    result.stdout.fnmatch_lines(\n+        [\"*<Module __init__.py>*\", \"*<Function test_init>*\"]\n+    )\n",
    "fact": "S1 keeps the __init__.py branch and distinguishes explicit initial paths/package hierarchy; REVIEW removes the blanket __init__.py allowance and regresses Package parent identity, SPRINT only changes yield placement and leaves both target tests failing."
  },
