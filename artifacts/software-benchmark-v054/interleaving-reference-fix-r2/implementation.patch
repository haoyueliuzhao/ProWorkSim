+def read_native_reference(value):
+    """The original MATCH writer has path+SHA references, without a byte count.
+
+    Validate that exact narrow schema here; generic v054 checked() stays strict.
+    Parse the same bytes that were hashed, rather than reopening the file.
+    """
+    if (not isinstance(value, dict) or set(value) not in (
+            {"path", "sha256"}, {"path", "sha256", "bytes"})
+            or not isinstance(value.get("path"), str)
+            or not isinstance(value.get("sha256"), str)
+            or re.fullmatch(r"[a-f0-9]{64}", value["sha256"]) is None):
+        raise ValueError("Invalid immutable MATCH native evidence reference")
+    path = Path(value["path"])
+    if not path.is_absolute() or str(path.resolve()) != value["path"]:
+        raise ValueError("MATCH native evidence path changed")
+    raw = path.read_bytes()
+    if (hashlib.sha256(raw).hexdigest() != value["sha256"]
+            or ("bytes" in value and (type(value["bytes"]) is not int or value["bytes"] != len(raw)))):
+        raise ValueError("Immutable MATCH native evidence content changed")
+    return json.loads(raw)
+
+
+def accounted_usage(response, arm):
+    """Retain owner-settled usage before offline projection/schema validation."""
+    body = response["body"]
+    usage = body["usage"]
+    if (any(type(usage.get(key)) is not int for key in (
+            "prompt_tokens", "completion_tokens", "total_tokens"))
+            or not 0 < usage["prompt_tokens"] <= 8192
+            or not 0 < usage["completion_tokens"] <= 2048
+            or usage["total_tokens"] != usage["prompt_tokens"] + usage["completion_tokens"]):
+        raise ValueError("Returned original usage is incomplete or outside the synthetic permit")
+    if arm == "MATCH":
+        ledger = response["ledger"]
+        calls = ledger.get("calls", [])
+        if (not calls or ledger.get("inflight") is not None
+                or ledger.get("uncertain_reserved_tokens", 0)
+                or ledger.get("attempts") != len(calls)
+                or calls[-1]["usage"] != usage
+                or body["id"] != "v054-match-" + calls[-1]["native_attempt_id"]
+                or type(ledger.get("complete_actual_tokens")) is not int
+                or ledger["complete_actual_tokens"] != ledger.get("known_actual_tokens")
+                or sum(row["usage"]["total_tokens"] for row in calls) != ledger["complete_actual_tokens"]):
+            raise ValueError("Returned MATCH usage lacks a completely settled original owner ledger")
+    elif arm != "PROJECT" or response.get("http_status") != 200:
+        raise ValueError("Only a completed original MATCH/PROJECT response can establish usage")
+    return copy.deepcopy(usage)
 
 
